# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# MySQL connection string
DATABASE_URL="mysql://indish_user:CHANGE_ME@localhost:3306/indish"

# JWT — generate your own with: openssl rand -base64 48
# Never reuse this placeholder as a real secret, and never let a real one end
# up in this file — it's the one meant to be committed to version control.
JWT_SECRET="REPLACE_ME_GENERATE_YOUR_OWN_SECRET_WITH_OPENSSL_RAND_BASE64_48"
JWT_EXPIRES_IN="12h"

# Comma-separated list of allowed frontend origins
CORS_ORIGIN="http://localhost:5173"

# Deposit policy
DEPOSIT_PER_GUEST_ZMW=100

# Mobile money numbers customers pay to are NOT set here — they're
# client-confirmed, per-branch values hardcoded in
# src/config/paymentNumbers.ts (mirrored in the frontend's
# src/data/reservation.ts). Keep both in sync if a number ever changes.

# WhatsApp Cloud API (Meta) — used to send reservation notifications.
# https://developers.facebook.com/apps -> your app -> WhatsApp -> API Setup
# Use a System User token (Business Settings > Users > System Users) set to
# never expire, not a short-lived Graph API Explorer token.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_API_VERSION="v21.0"
# Set once a reservation-confirmation template is approved in Meta Business
# Manager — see buildConfirmationTemplateParams() in whatsapp.service.ts.
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_LANGUAGE=en
# Set once each matching template is approved — see the sendXxxNotification()
# functions in whatsapp.service.ts.
# WHATSAPP_UNDER_REVIEW_TEMPLATE_NAME=
# WHATSAPP_AUTO_REJECTED_TEMPLATE_NAME=
# WHATSAPP_REJECTED_TEMPLATE_NAME=
# WHATSAPP_REQUEST_SCREENSHOT_TEMPLATE_NAME=
WHATSAPP_AUTOMATED_NOTICE_TEMPLATE_NAME="automated_notice"
# Set once staff_payment_review_alert is approved — a staff-facing (not
# customer-facing) template, so NOTIFY_PHONE_NUMBER reliably gets pinged
# when a payment lands in REQUIRES_REVIEW, not just when it's messaged
# the WhatsApp Business number in the last 24h:
# WHATSAPP_STAFF_REVIEW_TEMPLATE_NAME=

# Takeaway order templates — set each once approved in Meta Business Manager.
# See the sendTakeaway*() functions in whatsapp.service.ts. Until set, every
# one of these falls back to free-form text (24h-session limitation).
# WHATSAPP_TAKEAWAY_CREATED_TEMPLATE_NAME=
# WHATSAPP_TAKEAWAY_STAFF_NEW_ORDER_TEMPLATE_NAME=
# WHATSAPP_TAKEAWAY_UNDER_REVIEW_TEMPLATE_NAME=
# WHATSAPP_TAKEAWAY_STAFF_REVIEW_TEMPLATE_NAME=
# WHATSAPP_TAKEAWAY_AUTO_REJECTED_TEMPLATE_NAME=
# WHATSAPP_TAKEAWAY_REQUEST_SCREENSHOT_TEMPLATE_NAME=
# WHATSAPP_TAKEAWAY_CONFIRMED_TEMPLATE_NAME=
# WHATSAPP_TAKEAWAY_REJECTED_TEMPLATE_NAME=
# WHATSAPP_TAKEAWAY_READY_TEMPLATE_NAME=

# Catering enquiry templates — set each once approved. See
# sendCateringEnquiryNotifications() in whatsapp.service.ts.
# WHATSAPP_CATERING_ENQUIRY_TEMPLATE_NAME=
# WHATSAPP_CATERING_STAFF_TEMPLATE_NAME=

# Inbound webhook — powers the FAQ auto-answers (hours/booking/branches/menu).
# VERIFY_TOKEN: generate your own random string (e.g. openssl rand -hex 24),
# paste the same value into Meta App Dashboard > WhatsApp > Configuration >
# Webhook when registering the callback URL.
# APP_SECRET: from Meta App Dashboard > Settings > Basic > App Secret.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# Staff copy: every reservation notification also gets sent here
# (in addition to the customer's own number). E.164 format required.
# Per-branch overrides — set these and each branch's own admin gets pinged
# for that branch's reservations instead of everything going to one number.
# NOTIFY_PHONE_NUMBER is still used as the fallback for any branch without
# its own number set (and for anything that isn't branch-specific). Each
# var can hold more than one number, comma-separated (no spaces) — every
# listed number gets its own copy of the alert.
NOTIFY_PHONE_NUMBER="+260964599763"
NOTIFY_PHONE_NUMBER_LUSAKA="+260979771033"
NOTIFY_PHONE_NUMBER_KITWE="+260965545454,+260966008080,+260964101101,+260963240240"

ADMIN_COOKIE_NAME="indish_admin_token"

# Used only by prisma/seed.ts to create the first admin login
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="admin123"
