# Copy this file to .env for local development (never commit the real .env).
# On Netlify, set the same keys under Site settings → Environment variables.

# --- MySQL connection ---
# Local dev with MySQL Workbench: host is usually 127.0.0.1, port 3306.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=indish_loyalty
# Set to "true" only if your provider requires SSL (most managed MySQL hosts do, including Aiven).
DB_SSL=false
# For Aiven/most managed MySQL: save the CA certificate from their console
# (Overview → CA certificate → Show) as a .pem file and point to it here.
# This is much safer than pasting a multi-line cert directly into .env.
DB_SSL_CA_PATH=

# --- Sessions ---
# Any long random string. Generate one with: openssl rand -base64 32
SESSION_SECRET=changeme-generate-a-real-secret

# --- Used only by `npm run db:setup` to create the first manager login ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Amaka Phiri

# --- Cross-app links ---
# Base URL of the separate restaurant reservations app.
VITE_RESTAURANT_ADMIN_URL=http://localhost:5173

# --- WhatsApp Cloud API (Meta) — sends a welcome message on registration ---
# Reuse the same credentials as the restaurant backend (backend/.env) — same
# Meta Business number/account.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Set once a loyalty-registration template is approved in Meta Business Manager:
# WHATSAPP_LOYALTY_TEMPLATE_NAME=
# WHATSAPP_LOYALTY_TEMPLATE_LANGUAGE=en

# Owner/staff number that gets a copy of every new registration (E.164, e.g. +260964599763).
LOYALTY_NOTIFY_PHONE_NUMBER=
